# Copy to .env and paste the SDK environment key from your Flagsmith environment.
FLAGSMITH_ENVIRONMENT_KEY=

# Set to cloud if your project is on app.flagsmith.com.
FLAGSMITH_MODE=self-hosted
# Used only in self-hosted mode. The adapter appends the API paths.
FLAGSMITH_ORIGIN=http://localhost:8000

# Local inference endpoints.
OLLAMA_ORIGIN=http://127.0.0.1:11434
LM_STUDIO_ORIGIN=http://127.0.0.1:1234
# Set only if LM Studio authentication is enabled.
LM_STUDIO_API_KEY=

# Optional dashboard settings.
# AEGIS_DB=aegis.sqlite3
# AEGIS_MANIFEST=measured-manifest.json
# AEGIS_FLAGSMITH_COUNTS=flagsmith-counts.json
