# Copy once to .env. Choose cloud or self-hosted.
FLAGSMITH_MODE=self-hosted
# Set the client-side SDK key for each instance you use.
FLAGSMITH_CLOUD_ENVIRONMENT_KEY=
FLAGSMITH_LOCAL_ENVIRONMENT_KEY=
# Used in self-hosted mode.
FLAGSMITH_ORIGIN=http://localhost:8000

# Local inference endpoints.
OLLAMA_ORIGIN=http://127.0.0.1:11434
LM_STUDIO_ORIGIN=http://127.0.0.1:1234
# Set only if LM Studio authentication is enabled.
LM_STUDIO_API_KEY=

# Optional dashboard settings.
# AEGIS_DB=aegis.sqlite3
# AEGIS_MANIFEST=benchmarks/qwen-measured-01/manifest.json
# AEGIS_FLAGSMITH_COUNTS=benchmarks/qwen-measured-01/flagsmith-counts.json
# AEGIS_CONNECTOR_URL=http://127.0.0.1:9000/run

# Optional cloud starter agent. Use a tool-calling model available on your account.
# AEGIS_CLOUD_BASE_URL=https://api.groq.com/openai/v1
# AEGIS_CLOUD_MODEL=openai/gpt-oss-20b
# AEGIS_CLOUD_API_KEY=
# AEGIS_STARTER_CONFIG=examples/invoice/starter.json
# To use the starter with LM Studio, set the exact model ID here.
# AEGIS_STARTER_LMSTUDIO_MODEL=qwen2.5-3b-instruct
